# Copy to .env for local development. Do not commit real secrets.
# Point the app at this file with: DOCVERSION_ENV_FILE=/etc/docversion/.env
DOCVERSION_ENV_FILE=
DOCVERSION_APP_NAME=docversion
DOCVERSION_ENVIRONMENT=development
DOCVERSION_DEBUG=false
DOCVERSION_LOG_LEVEL=INFO
# Local PostgreSQL (no TLS):
DOCVERSION_DATABASE_URL=postgresql+asyncpg://docversion:docversion@localhost:5432/docversion
# Supabase (managed Postgres) via Supavisor pooler, session mode, port 6543:
#   DOCVERSION_DATABASE_URL=postgresql+asyncpg://postgres.<ref>.<region>.pooler.supabase.com:6543/postgres
#   DOCVERSION_DATABASE_SSLMODE=require
# Force TLS for both the async engine and the sync APScheduler jobstore.
DOCVERSION_DATABASE_SSLMODE=
DOCVERSION_DATABASE_POOL_SIZE=5
DOCVERSION_DATABASE_MAX_OVERFLOW=10
DOCVERSION_DATABASE_CONNECT_TIMEOUT_SECONDS=10
DOCVERSION_JWT_SECRET_KEY=dev-only-insecure-secret-change-me
DOCVERSION_ACCESS_TOKEN_EXPIRE_MINUTES=15
DOCVERSION_REFRESH_TOKEN_EXPIRE_DAYS=30
# Leave SMTP host empty to disable outbound email (dev mode).
DOCVERSION_SMTP_HOST=smtp-relay.brevo.com
DOCVERSION_SMTP_PORT=587
DOCVERSION_SMTP_USERNAME=
DOCVERSION_SMTP_PASSWORD=
DOCVERSION_MAIL_FROM=noreply@example.com
DOCVERSION_FRONTEND_URL=http://localhost:5173
# Snapshot/git-export storage on the host.
DOCVERSION_SNAPSHOT_STORAGE_DIR=/var/lib/docversion/snapshots
DOCVERSION_GIT_EXPORT_BASE_DIR=/var/lib/docversion/git-exports
# NVIDIA LLM (free tier, platform-shared key). In production store the key
# encrypted with DOCVERSION_NVIDIA_API_KEY_ENCRYPTED and set the Fernet master key.
DOCVERSION_FERNET_MASTER_KEY=
DOCVERSION_NVIDIA_API_KEY=
DOCVERSION_NVIDIA_API_KEY_ENCRYPTED=
DOCVERSION_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
DOCVERSION_NVIDIA_MODEL=meta/llama-3.3-70b-instruct
DOCVERSION_LLM_CALL_TIMEOUT_SECONDS=60
DOCVERSION_LLM_RATE_PER_MINUTE=10
DOCVERSION_SCRAPE_TIMEOUT_SECONDS=30
